/* M2 ANSI sweep: catch implicit function declarations (revival/doc/roadmap.md, M2) */
COMPILERFLAGS = -std=gnu89 -Wno-implicit-int -Werror=implicit-function-declaration -Wno-incompatible-function-pointer-types -Wno-return-type

DependTarget()

NormalObjectRule()
ProgramTarget(testindex, testidx.o, libindex.a,)
LibraryTarget(libindex.a, index.o indexio.o rcordset.o)
InstallLibrary(libindex.a, $(DESTDIR)/lib)
InstallFile(index.h, $(INSTINCFLAGS), $(DESTDIR)/include)
