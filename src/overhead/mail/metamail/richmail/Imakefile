LOCALINCLUDES =-I..

/* M2 ANSI sweep: catch implicit function declarations (revival/doc/roadmap.md, M2) */
COMPILERFLAGS = -std=gnu89 -Wno-implicit-int -Werror=implicit-function-declaration -Wno-incompatible-function-pointer-types -Wno-return-type

RICHOBJS = richlex.o richset.o usascii.o iso2022.o

NormalObjectRule()
NormalATKRule()

#if defined(hpux) && HP_OS >= 80
TERMLIB = -lcurses
#else
#ifndef SOLARIS
TERMLIB = -ltermcap
#else
TERMLIB= -L/usr/ccs/lib -ltermcap
#endif
#endif

ProgramTarget(richtext, richtext.o ${RICHOBJS},,${TERMLIB})
ProgramTarget(richtoatk, richtoatk.o ${RICHOBJS},,)
InstallProgram(richtoatk, ${DESTDIR}/bin)
InstallProgram(richtext, ${DESTDIR}/bin)
DependTarget()
