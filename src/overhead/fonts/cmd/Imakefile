/* M2 ANSI sweep: catch implicit function declarations (revival/doc/roadmap.md, M2) */
COMPILERFLAGS = -std=gnu89 -Wno-implicit-int -Werror=implicit-function-declaration -Wno-incompatible-function-pointer-types -Wno-return-type

DependTarget()
NormalObjectRule()

#ifdef X11_ENV
ProgramTarget(fdbbdf, fdbbdf.o, ,)
InstallProgram(fdbbdf, $(DESTDIR)/bin)
#endif /* X11_ENV */

#ifdef WM_ENV
ProgramTarget(fdbwm, fdbwm.o, $(WMBASEDIR)/lib/libfont.a $(UTILLIB), ${BSDLIB})
InstallProgram(fdbwm, $(DESTDIR)/bin)
ProgramTarget(wmfdb, wmfdb.o, $(WMBASEDIR)/lib/libfont.a $(UTILLIB), ${BSDLIB})
InstallProgram(wmfdb, $(DESTDIR)/bin)
#endif /* WM_ENV */

