\textdsversion{12}
\htmlatk-link{THE WRITER'S LIFE\
}\enddata{text,36222760288}
0 0 0 36222760288 0 0 0
>OBJ< text
>VIEW< textview
>REF< 
\enddata{lset,36222779392}
\view{lsetview,36222779392,125,0,0}
\begindata{lset,36222779648}
\V 1
\begindata{text,36222760512}
\textdsversion{12}
[image]Meryl Branch-McTiernan is an essayist and screenwriter as well as 
the author of the debut novel \htmlatk-italic{What You Should Worry About}, 
in which 37-year-old Layla Moody navigates the Covid-19 pandemic while 
finding family on her own terms. Discover which hefty tome she partied with 
in lockdown and which famously controversial novel she considers essential 
reading on "the balance between artistic, relational, and familial 
desires"... \htmlatk-bold{\htmlatk-link{(continued)}}


\enddata{text,36222760512}
