\begindata{text,37325276928}
\textdsversion{12}
\htmlatk-link{[image: Safety During Extreme Heat With peak summer 
temperatures here, it?s important to make heat safety a priority. Drink 
plenty of water, stay in cool spaces, and check on loved ones during 
periods of extreme heat. Customers enrolled in text alerts may also receive 
weather-related safety information from us.]\
}\enddata{text,37325276928}

\enddata{table,37325324448}
\view{spread,37325324448,9,0,0\
}\enddata{text,37325276704}

