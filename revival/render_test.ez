\begindata{text,4317471872}
\textdsversion{12}
\htmlatk-link{[image: Investing in Reliable Energy For more than 40 years, 
a South Boston gas regulator station has helped deliver natural gas to 
approximately 22,000 customers across the greater Boston area. Now, we're 
investing in modern infrastructure to upgrade the facility, strengthen 
reliability, and help ensure our energy network is ready to meet customers' 
needs for decades to come.]\
}\enddata{text,4317471872}
