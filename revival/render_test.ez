\begindata{lset,36222626560}
\V 1
\begindata{text,36222612160}
\textdsversion{12}
\htmlatk-link{WHAT TO READ NEXT: REVIEWS OF GREAT BOOKS\
}\enddata{text,36222612160}
0 0 0 36222612160 0 0 0
>OBJ< text
>VIEW< textview
>REF< 
