#!/usr/bin/env python3
"""imap-writeback-tests -- milestone 4's Gate 1 capture/suppression suite
(msjournal.c and its four hook sites in src/ams/libs/ms/: altsnap.c,
purge.c, clonemsg.c, apndfile.c). See
revival/doc/imap-writeback-prompt.md and revival/doc/claude-history/
imap-writeback-REPORT.md.

Gate 1 scope: local capture into ".MS_Journal" and the
MSJournal_Suppress(1) imapsync sets at startup. As of Gate 2,
imapsync's own replay_folder() also *acts on* a pending ".MS_Journal"
on every ordinary run -- so unlike Gate 1, this suite's "suppression"
re-run step is a real write path, not just EXAMINE/UID FETCH/UID
SEARCH. See the 2026-07-23 incident section of imap-writeback-REPORT.md:
an earlier version of this suite mirrored a real, pre-existing folder
(INBOX/1-Admin/keys) rather than a sandbox, and this suite's own case 1
+ suppression re-run permanently deleted one real message from it via a
genuine UID STORE/UID EXPUNGE once Gate 2's replay code existed. This
suite now confines every write -- the cui-driven local mutations, the
journal they produce, and every imapsync run that might replay that
journal -- to the dedicated scratch folder named by AUIS_TEST_FOLDER,
which it seeds with its own throwaway messages up front and from which
it removes, on exit (pass or fail), only the messages harnesses
created (see "Never empties a folder" below). Nothing here hand-writes
.MS_Journal or .MS_MsgDir bytes -- the mutations under test (delete/
undelete/purge, and case 5's compose+save-as-draft) are driven through
the real, unmodified `cui` binary against the sandbox's mirrored copy.

Case 5 (added for Gate 3, append replay): run_cui_append() composes a
fresh message via cui's "mail" command and saves it as a draft
directly into the sandbox folder (SEND_SAVEDRAFT ->
MS_AppendFileToFolder) -- a genuinely native-id local message, real
end-to-end proof that a "J1 append" record captured this way replays
correctly in the very next imapsync run (journal-then-mirror, in one
invocation) and converges on a deterministic id exactly once. See
run_cui_append()'s own docstring for why this is used instead of a
literal cui "copy" (both directions of a two-folder copy hit
MS_CloneMessage's own id-collision guard).

Configuration (no defaults; every live case is skipped, with one
message listing what is missing, unless all three are set to
non-blank values):

    AUIS_TEST_ADDRESS    your own test mailbox address -- the From:/To:
                         of the seed messages and the recipient typed
                         into cui's composer for the drafts
    AUIS_TEST_IMAP_HOST  the IMAP server; ~/.netrc must have a
                         "machine <that host>" stanza
    AUIS_TEST_FOLDER     the IMAP folder every write goes to. It MUST be
                         a dedicated scratch folder holding no real mail.

With any of them unset nothing here touches the network. Two further
limits come from C code this suite does not change, and are reported
as skip reasons rather than worked around: imapsync connects only to
imap.fastmail.com (src/ams/msclients/imapsync/imap_sync.c:214-216,
DEFAULT_HOST/DEFAULT_NETRC_MACHINE, no override), and imaptest.test's
write subcommands refuse every mailbox but "Revival/WritebackTest"
(src/overhead/mail/lib/imaptest.c:400, WRITE_MAILBOX_GUARD).

Never empties a folder (2026-11 incident: an earlier cleanup ran
"expunge 1:*" on the whole folder and deleted the owner's own mail
there). Before any write, preflight_folder() lists every message in
AUIS_TEST_FOLDER (a read-only imapsync mirror into a throwaway root:
no journal exists there, so imapsync only EXAMINEs/FETCHes) and
refuses the run, touching nothing, if any message's Subject lacks one
of HARNESS_SUBJECT_MARKERS. Leftover marker messages from earlier runs
are removed by exact UID. Cleanup likewise removes only marker-subject
messages (and UIDs this run's APPENDs reported), by exact UID set via
UID STORE \\Deleted + UID EXPUNGE -- never a range, never 1:*.
Mirrors AUIS_TEST_FOLDER into fresh `mktemp -d` scratch roots; never
touches the real ~/.IMAP or ~/preferences.
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

REPO_ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
IMAPSYNCDIR = os.path.join(REPO_ROOT, "src", "ams", "msclients", "imapsync")
IMAPSYNC = os.path.join(IMAPSYNCDIR, "imapsync")
MAILLIB = os.path.join(REPO_ROOT, "src", "overhead", "mail", "lib")
IMAPTEST = os.path.join(MAILLIB, "imaptest.test")
CUI = os.path.join(REPO_ROOT, "build", "bin", "cui")

PORT = "993"
NETRC = os.path.expanduser("~/.netrc")


def _env(name):
    """Unset, empty, and whitespace-only all mean "not set"."""
    return os.environ.get(name, "").strip()


# Live configuration, all from the environment -- no defaults. See the
# module docstring. HOST doubles as the ~/.netrc machine name.
TEST_ADDRESS = _env("AUIS_TEST_ADDRESS")
HOST = _env("AUIS_TEST_IMAP_HOST")
MACHINE = HOST
FOLDER = _env("AUIS_TEST_FOLDER")

REQUIRED_VARS = (
    ("AUIS_TEST_ADDRESS", "you@example.com"),
    ("AUIS_TEST_IMAP_HOST", "imap.example.com"),
    ("AUIS_TEST_FOLDER", "Scratch/AUISTests"),
)

# Values hard-coded in C that this suite cannot override (see the
# module docstring); a mismatch skips the live cases with this reason.
IMAPSYNC_ONLY_HOST = "imap.fastmail.com"   # imap_sync.c:214 DEFAULT_HOST / :216 DEFAULT_NETRC_MACHINE
IMAPTEST_ONLY_WRITE_FOLDER = "Revival/WritebackTest"   # imaptest.c:400 WRITE_MAILBOX_GUARD

# Subject prefixes of every message any of the three IMAP live suites
# (imap-protocol-tests, imap-sync-tests, imap-writeback-tests) puts in
# the scratch folder. The same list appears in each suite, since they
# share the folder and each must recognize the others' leftovers. A
# message whose Subject starts with none of these was not created by a
# harness: preflight refuses to run against a folder holding one, and
# cleanup never deletes one.
HARNESS_SUBJECT_MARKERS = (
    "GATE2-WRITEBACK-SEED-",               # imap-writeback-tests seeds
    "GATE3-CASE5-APPEND-",                 # imap-writeback-tests case 5 draft
    "GATE3-ACCEPTANCE-COPYIN",             # imap-writeback-tests acceptance draft
    "GATE2-W2-FLAGS-",                     # imap-sync-tests W2
    "GATE2-W3-PURGE-",                     # imap-sync-tests W3
    "GATE2-W7-STALE-",                     # imap-sync-tests W7
    "GATE3-W5-APPEND-",                    # imap-sync-tests W5 draft
    "GATE3-W6-FLAGS-",                     # imap-sync-tests W6
    "GATE3-W6-APPEND-",                    # imap-sync-tests W6 draft (+ its manual re-append)
    "IMAP-PROTOCOL-TESTS-WRITEBACK-CASE",  # imap-protocol-tests case 11
)

# Set only by a passing preflight_folder(); every message-level write
# (append/storeflags/expunge, imapsync runs that may replay a journal,
# cui sessions) asserts it first.
PREFLIGHT_OK = False

# (uidvalidity, uid) of every message this run APPENDed itself.
RECORDED_APPENDS = []

AMS_ATT_DELETED = 2
AMS_ATT_UNSEEN = 6
ATTRSIZE = 21

PASS = []
FAIL = []
SKIP = []


def missing_vars_message():
    """Returns (missing_names, message) -- message is None when nothing
    is missing. Printed once, at the start of main()."""
    missing = [(n, ex) for n, ex in REQUIRED_VARS if not _env(n)]
    if not missing:
        return [], None
    lines = ["Live-account cases skipped; set these to run them:"]
    lines += [f"    export {n}={ex}" for n, ex in missing]
    lines.append("(credentials come from ~/.netrc, machine = the host)")
    names = [n for n, _ in missing]
    if "AUIS_TEST_FOLDER" in names:
        lines.append("AUIS_TEST_FOLDER must be a dedicated scratch folder holding no real mail; "
                     "live runs refuse a folder containing any message this suite did not create.")
        lines.append(f"Note: imaptest.c:400 only permits writes to {IMAPTEST_ONLY_WRITE_FOLDER!r}, "
                     "so that is currently the only folder these cases can use.")
    if "AUIS_TEST_IMAP_HOST" in names:
        lines.append(f"Note: imapsync is hard-wired to {IMAPSYNC_ONLY_HOST} (imap_sync.c:214-216), "
                     "so this suite can currently run only against that host.")
    return names, "\n".join(lines)


def c_hardcode_mismatches():
    """Reasons the live cases cannot run even with every variable set,
    because C code this suite does not change hard-codes a different
    value (see the module docstring)."""
    why = []
    if HOST != IMAPSYNC_ONLY_HOST:
        why.append(f"AUIS_TEST_IMAP_HOST={HOST!r}, but imapsync connects only to "
                   f"{IMAPSYNC_ONLY_HOST!r} (src/ams/msclients/imapsync/imap_sync.c:214-216, "
                   "no override)")
    if FOLDER != IMAPTEST_ONLY_WRITE_FOLDER:
        why.append(f"AUIS_TEST_FOLDER={FOLDER!r}, but imaptest.test's write subcommands refuse "
                   f"every mailbox except {IMAPTEST_ONLY_WRITE_FOLDER!r} "
                   "(src/overhead/mail/lib/imaptest.c:400 WRITE_MAILBOX_GUARD)")
    return why


def is_harness_subject(subject):
    s = (subject or "").strip()
    return any(s.startswith(m) for m in HARNESS_SUBJECT_MARKERS)


def note(msg):
    print(msg, flush=True)


def result(name, ok, detail=""):
    if ok:
        PASS.append(name)
        note(f"PASS: {name}")
    else:
        FAIL.append(name)
        note(f"FAIL: {name}" + (f" -- {detail}" if detail else ""))


def skip(name, reason):
    SKIP.append(name)
    note(f"SKIP: {name} -- {reason}")


def assert_folder_is_sandbox(folder, need_preflight=True):
    """The one Python-level enforcement point every mutating call in this
    file funnels through (run_imapsync, the cui sessions, imaptest_wb,
    expunge_uids). Refuses unless `folder` is exactly AUIS_TEST_FOLDER
    (never INBOX), and -- for anything that can change messages, i.e.
    everything except CREATE of the folder itself -- unless
    preflight_folder() has verified the folder holds nothing but
    harness-created messages. Independent of imaptest.c's own
    guard_mailbox() (imaptest.c:400), which separately limits the
    create/storeflags/expunge/append subcommands to one mailbox name at
    the C level."""
    if not FOLDER or folder != FOLDER or folder.upper() == "INBOX":
        sys.exit(f"imap-writeback-tests: REFUSING to run against folder {folder!r} "
                 f"-- only AUIS_TEST_FOLDER ({FOLDER!r}, never INBOX) is allowed")
    if need_preflight and not PREFLIGHT_OK:
        sys.exit(f"imap-writeback-tests: REFUSING a write to {folder!r} before "
                 "preflight_folder() has verified it holds only harness-created messages")


def build(dirpath, target, binpath, timeout=180):
    if not os.path.isfile(os.path.join(dirpath, "Makefile")):
        r = subprocess.run(["imake", "-Timake.tmpl", "-I.", "-I../../../config",
                             "-s", "Makefile", "-DTOPDIR=../../../."],
                            cwd=dirpath, capture_output=True, text=True)
        if r.returncode != 0:
            note(r.stdout); note(r.stderr)
            sys.exit(f"imap-writeback-tests: could not bootstrap Makefile in {dirpath}")
    r = subprocess.run(["make", "Makefile"], cwd=dirpath, capture_output=True, text=True)
    if r.returncode != 0:
        note(r.stdout); note(r.stderr)
        sys.exit(f"imap-writeback-tests: 'make Makefile' failed in {dirpath}")
    r = subprocess.run(["make", target], cwd=dirpath, capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0 or not os.path.isfile(binpath):
        note(r.stdout); note(r.stderr)
        sys.exit(f"imap-writeback-tests: 'make {target}' failed in {dirpath}")


def build_imaptest():
    build(MAILLIB, "imaptest.test", IMAPTEST)


def build_imapsync():
    build(IMAPSYNCDIR, "imapsync", IMAPSYNC)


def have_live_credentials():
    if not os.path.isfile(NETRC):
        return False
    try:
        r = subprocess.run([IMAPTEST, "login", HOST, PORT, NETRC, MACHINE],
                            capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return False
    return r.returncode == 0


def run_imapsync(root, timeout=120):
    """An imapsync run that may replay a pending journal (a real write
    path) -- requires a passed preflight."""
    assert_folder_is_sandbox(FOLDER)
    r = subprocess.run([IMAPSYNC, "-root", root, "-folders", FOLDER, "-v"],
                        capture_output=True, text=True, timeout=timeout)
    return r


def imaptest_wb(subcmd, folder, *rest, timeout=60):
    """Runs a writing (create/storeflags/expunge/append) imaptest.test
    subcommand against `folder`, guarded by assert_folder_is_sandbox()
    here (CREATE alone is allowed before the preflight: it only ever
    makes an empty folder) in addition to imaptest.c's own
    guard_mailbox() at the C level. "expunge" must go through
    expunge_uids(), which validates the UID set. Returns
    (CompletedProcess, kv dict)."""
    assert_folder_is_sandbox(folder, need_preflight=(subcmd != "create"))
    if subcmd == "expunge" and not re.fullmatch(r"[1-9]\d*(,[1-9]\d*)*", str(rest[0]) if rest else ""):
        sys.exit(f"imap-writeback-tests: REFUSING expunge with UID set {rest!r} -- "
                 "only an explicit list of single UIDs is ever allowed (never a range or 1:*)")
    r = subprocess.run([IMAPTEST, subcmd, HOST, PORT, NETRC, MACHINE, folder]
                        + [str(a) for a in rest],
                        capture_output=True, text=True, timeout=timeout)
    return r, _parse_kv(r.stdout)


def imaptest_readonly(subcmd, folder, *rest, timeout=60):
    """Like imaptest_wb but for read-only subcommands (examine) that take
    a folder argument -- no guard needed since these never write, kept as
    a separate name so it's obvious at each call site whether the guard
    is in play (same convention as imap-sync-tests)."""
    r = subprocess.run([IMAPTEST, subcmd, HOST, PORT, NETRC, MACHINE, folder]
                        + [str(a) for a in rest],
                        capture_output=True, text=True, timeout=timeout)
    return r, _parse_kv(r.stdout)


def _parse_kv(stdout):
    """"KEY: value" line parser matching imap-sync-tests'/
    imap-protocol-tests' own inline parsing: a leading "N (" on the value
    (e.g. "0 (IMAP_OK)") is collapsed to just the numeric code."""
    kv = {}
    for line in stdout.splitlines():
        if ": " in line:
            k, v = line.split(": ", 1)
            m = re.match(r'^(-?\d+)\s*\(', v.strip())
            kv[k.strip()] = m.group(1) if m else v.strip()
    return kv


def append_seed_message(tmpdir, tag):
    """APPENDs one small, pre-marked-\\Seen throwaway message into
    FOLDER via imap_Append (imaptest.test's append subcommand), using
    the same mechanism/convention imap-sync-tests' W-cases use
    (append_test_message()). Pre-marking \\Seen preserves case 1's
    existing "type 1 is a no-op" assumption (the folder starts empty
    after preflight, so this suite has to manufacture that precondition
    itself). Records the APPENDUID in RECORDED_APPENDS for cleanup.
    Returns (uidvalidity, uid), or (None, None) on failure."""
    bodyfile = os.path.join(tmpdir, f"seed-{tag}.eml")
    with open(bodyfile, "wb") as f:
        f.write(
            f"Date: {time.strftime('%a, %d %b %Y %H:%M:%S %z')}\r\n"
            f"From: {TEST_ADDRESS}\r\n"
            f"To: {TEST_ADDRESS}\r\n"
            f"Subject: GATE2-WRITEBACK-SEED-{tag}\r\n"
            f"\r\n"
            f"imap-writeback-tests seed message ({tag}) -- throwaway; this "
            f"suite removes it (by UID) again before exiting.\r\n"
        .encode())
    r, kv = imaptest_wb("append", FOLDER, bodyfile, r"\Seen")
    if r.returncode != 0 or kv.get("APPEND-RC") != "0":
        return None, None
    uv = kv.get("APPEND-UIDVALIDITY")
    uid = kv.get("APPEND-UID")
    if uv is None or uid is None or not uv.isdigit() or not uid.isdigit():
        return None, None
    RECORDED_APPENDS.append((int(uv), int(uid)))
    return int(uv), int(uid)


# ---- folder safety: listing, preflight, UID-exact cleanup ----

_BASE32HEX = "0123456789ABCDEFGHIJKLMNOPQRSTUV"
_SYNTH_ID_RE = re.compile(r"^IMAP([0-9A-V]{7})([0-9A-V]{7})$")


def decode_synth_id(ident):
    """Inverse of imap_sync.c's synth_id(): "IMAP" + base32hex7(uidvalidity)
    + base32hex7(uid). Returns (uidvalidity, uid), or None if ident is not
    a deterministic imapsync id."""
    m = _SYNTH_ID_RE.match(ident)
    if not m:
        return None

    def dec(chars):
        v = 0
        for c in chars:
            v = (v << 5) | _BASE32HEX.index(c)
        return v
    return dec(m.group(1)), dec(m.group(2))


def read_subject(path):
    """Decoded Subject header of a mirrored body file, or "" if absent or
    unparseable (which counts as a non-harness message -- the safe way to
    be wrong)."""
    import email.parser
    import email.policy
    try:
        with open(path, "rb") as f:
            msg = email.parser.BytesParser(policy=email.policy.default).parse(f, headersonly=True)
        subj = msg.get("Subject")
        return str(subj) if subj is not None else ""
    except Exception:
        return ""


def examine_folder():
    """(exists, uidvalidity, uidnext) for FOLDER via a read-only EXAMINE,
    or None if EXAMINE failed (e.g. the folder does not exist yet)."""
    _, kv = imaptest_readonly("examine", FOLDER)
    if kv.get("EXAMINE-RC") != "0":
        return None
    try:
        return int(kv["EXISTS"]), int(kv["UIDVALIDITY"]), int(kv.get("UIDNEXT", "0") or 0)
    except (KeyError, ValueError):
        return None


def list_folder_messages():
    """Every message in FOLDER as [(uidvalidity, uid, subject), ...], via
    an imapsync mirror into a brand-new throwaway root. A fresh root has
    no .MS_Journal, so replay_folder() has nothing to act on and imapsync
    only EXAMINEs/FETCHes (read-only). Returns (list, None) or
    (None, reason)."""
    root = tempfile.mkdtemp(prefix="imap-writeback-tests-listing-")
    try:
        r = subprocess.run([IMAPSYNC, "-root", root, "-folders", FOLDER],
                            capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            return None, f"read-only imapsync listing failed (exit {r.returncode}): {r.stderr.strip()[-300:]}"
        d = folder_dir(root)
        msgs = []
        if os.path.isdir(d):
            for name in sorted(os.listdir(d)):
                if not name.startswith("+"):
                    continue
                dec = decode_synth_id(name[1:])
                if dec is None:
                    return None, f"unexpected non-imapsync id {name!r} in listing mirror"
                msgs.append((dec[0], dec[1], read_subject(os.path.join(d, name))))
        return msgs, None
    finally:
        shutil.rmtree(root, ignore_errors=True)


def expunge_uids(uids, uidvalidity):
    """Deletes exactly these UIDs (UID STORE +FLAGS \\Deleted then UID
    EXPUNGE of the same explicit set -- imaptest.c cmd_expunge; UID
    EXPUNGE needs UIDPLUS and imap_prot.c refuses rather than falling
    back to a plain EXPUNGE). Re-checks UIDVALIDITY first so a UID can
    never name a different message. Returns (ok, detail)."""
    uids = sorted({int(u) for u in uids})
    if not uids:
        return True, "nothing to remove"
    if any(u <= 0 for u in uids):
        return False, f"refusing non-positive UID in {uids}"
    now = examine_folder()
    if now is None or now[1] != uidvalidity:
        return False, (f"UIDVALIDITY changed or EXAMINE failed (expected {uidvalidity}, got "
                       f"{None if now is None else now[1]}) -- not removing UIDs {uids}")
    uidset = ",".join(str(u) for u in uids)
    r, kv = imaptest_wb("expunge", FOLDER, uidset)
    ok = (r.returncode == 0 and kv.get("EXPUNGE-RC") == "0"
          and kv.get("POSTEXPUNGE-STILL-PRESENT") == "no")
    return ok, f"UID set {uidset}: exit={r.returncode} kv={kv}"


def preflight_folder(label):
    """Before any write: verify FOLDER holds nothing but harness-created
    messages (Subject starts with one of HARNESS_SUBJECT_MARKERS). Creates
    the folder if it does not exist. Any other message => refuse, touching
    nothing. Leftover harness messages from earlier runs are removed by
    exact UID so the run starts from an empty folder. Sets PREFLIGHT_OK.
    Returns (ok, reason)."""
    global PREFLIGHT_OK
    PREFLIGHT_OK = False
    info = examine_folder()
    if info is None:
        cr, ckv = imaptest_wb("create", FOLDER)
        note(f"preflight ({label}): {FOLDER!r} not examinable; CREATE -> exit={cr.returncode} kv={ckv}")
        info = examine_folder()
        if info is None:
            return False, f"could not EXAMINE (or create) {FOLDER!r}"
    exists, uidvalidity, _ = info
    if exists == 0:
        PREFLIGHT_OK = True
        note(f"preflight ({label}): {FOLDER!r} is empty -- OK")
        return True, ""
    msgs, err = list_folder_messages()
    if msgs is None:
        return False, f"could not list {FOLDER!r} to verify its contents ({err}); refusing to touch it"
    if len(msgs) != exists:
        return False, (f"listing of {FOLDER!r} saw {len(msgs)} message(s) but EXAMINE reports "
                       f"{exists}; cannot verify its contents, refusing to touch it")
    if any(uv != uidvalidity for uv, _, _ in msgs):
        return False, f"UIDVALIDITY of {FOLDER!r} changed during preflight; refusing to touch it"
    foreign = [uid for _, uid, subj in msgs if not is_harness_subject(subj)]
    if foreign:
        return False, (f"{FOLDER!r} contains {len(foreign)} message(s) not created by a test "
                       f"harness (UIDs {foreign}). AUIS_TEST_FOLDER must be a dedicated scratch "
                       "folder holding no real mail -- refusing the live run; nothing was changed")
    leftovers = [uid for _, uid, _ in msgs]
    PREFLIGHT_OK = True   # verified: everything present is harness-created
    ok, detail = expunge_uids(leftovers, uidvalidity)
    note(f"preflight ({label}): removed {len(leftovers)} leftover harness message(s) "
         f"from earlier runs -> {'ok' if ok else 'FAILED'}: {detail}")
    info = examine_folder()
    if not ok or info is None or info[0] != 0:
        PREFLIGHT_OK = False
        return False, (f"{FOLDER!r} not empty after removing harness leftovers "
                       f"(EXISTS={None if info is None else info[0]}); refusing to continue")
    return True, ""


def cleanup_folder(label):
    """Removes only harness-created messages: every message whose Subject
    carries a harness marker (this covers this run's APPENDs and the
    drafts imapsync's replay APPENDed for it), found via a fresh
    read-only listing. If listing fails, falls back to just the
    (uidvalidity, uid) pairs this run's own APPENDs reported. Never
    touches any other message, never uses a range."""
    if not PREFLIGHT_OK:
        note(f"cleanup ({label}): skipped -- preflight did not pass, {FOLDER!r} left untouched")
        return
    info = examine_folder()
    if info is None:
        note(f"cleanup ({label}): WARNING -- could not EXAMINE {FOLDER!r}; left in place: "
             f"this run's appended (uidvalidity, uid) = {RECORDED_APPENDS}")
        return
    exists, uidvalidity, _ = info
    if exists == 0:
        note(f"cleanup ({label}): {FOLDER!r} already empty, nothing to remove")
        return
    msgs, err = list_folder_messages()
    if msgs is None:
        uids = [uid for uv, uid in RECORDED_APPENDS if uv == uidvalidity]
        note(f"cleanup ({label}): listing failed ({err}); falling back to this run's own "
             f"recorded APPEND UIDs only: {uids} (other harness messages, e.g. replayed drafts, "
             "are left for the next run's preflight)")
    else:
        present = {uid: subj for uv, uid, subj in msgs if uv == uidvalidity}
        uids = [uid for uid, subj in present.items() if is_harness_subject(subj)]
        others = [uid for uid, subj in present.items() if not is_harness_subject(subj)]
        if others:
            note(f"cleanup ({label}): WARNING -- {len(others)} non-harness message(s) appeared in "
                 f"{FOLDER!r} during the run (UIDs {others}); left untouched")
        odd = [uid for uv, uid in RECORDED_APPENDS
               if uv == uidvalidity and uid in present and uid not in uids]
        if odd:
            note(f"cleanup ({label}): WARNING -- recorded APPEND UIDs {odd} no longer carry a "
                 "harness marker subject; left untouched")
    if not uids:
        note(f"cleanup ({label}): no harness-created messages to remove")
        return
    ok, detail = expunge_uids(uids, uidvalidity)
    if ok:
        note(f"cleanup ({label}): removed {len(uids)} harness-created message(s): {detail}")
    else:
        note(f"cleanup ({label}): WARNING -- removal failed, UIDs {sorted(uids)} left in "
             f"{FOLDER!r}: {detail}")


def folder_dir(root):
    return os.path.join(root, ".MESSAGES", FOLDER)


def msgdir_path(root):
    return os.path.join(folder_dir(root), ".MS_MsgDir")


def statepath(root):
    return os.path.join(folder_dir(root), ".MS_IMAPSync")


def journalpath(root):
    return os.path.join(folder_dir(root), ".MS_Journal")


def replayingpath(root):
    return os.path.join(folder_dir(root), ".MS_Journal.replaying")


def find_marker_files(root, needle):
    """Local "+<id>" body files in FOLDER whose content contains needle
    -- used by case 5 to find a message by its unique subject rather
    than by a specific id (the whole point is that the id changes, from
    a native one to a deterministic one, across the replay)."""
    d = folder_dir(root)
    found = []
    for name in os.listdir(d):
        if not name.startswith("+"):
            continue
        path = os.path.join(d, name)
        try:
            with open(path, "rb") as f:
                if needle.encode() in f.read():
                    found.append(path)
        except OSError:
            continue
    return found


# ---- direct .MS_MsgDir snapshot decoding (read-only; independent of
# cui, so the journal-content assertions below aren't just re-trusting
# the same code path they're testing) -- layout matches ams/libs/hdrs/
# ams.h (date(7)+caption(89)+chain(4)+midhash(4)+replyhash(4)+
# attributes(21)+id(19) = 148 bytes/record; header is 1024+148 bytes) ----

_DATESIZE, _CAPTIONSIZE, _CHAINSIZE, _MIDHASHSIZE, _REPLYHASHSIZE, _ATTRSIZE, _IDSIZE = 7, 89, 4, 4, 4, 21, 19
_CAPTOFF = _DATESIZE
_CHAINOFF = _CAPTOFF + _CAPTIONSIZE
_MIDOFF = _CHAINOFF + _CHAINSIZE
_REPLYOFF = _MIDOFF + _MIDHASHSIZE
_ATTROFF = _REPLYOFF + _REPLYHASHSIZE
_IDOFF = _ATTROFF + _ATTRSIZE
_SNAPSIZE = _IDOFF + _IDSIZE
_DIRHEADSIZE = 1024 + _SNAPSIZE


def read_snapshots_in_order(root):
    """Returns [(id, attrbytes), ...] in the same order cui numbers
    them ("headers <folder>" assigns cuids 1..N in exactly this
    on-disk record order for a fresh, unfiltered listing)."""
    path = msgdir_path(root)
    out = []
    with open(path, "rb") as f:
        data = f.read()
    n = (len(data) - _DIRHEADSIZE) // _SNAPSIZE
    for i in range(n):
        rec = data[_DIRHEADSIZE + i * _SNAPSIZE: _DIRHEADSIZE + (i + 1) * _SNAPSIZE]
        ident = rec[_IDOFF:_IDOFF + 18].decode(errors="replace")
        attrs = rec[_ATTROFF:_ATTROFF + _ATTRSIZE]
        out.append((ident, attrs))
    return out


def hexmask(bytelist):
    return "".join("%02x" % b for b in bytelist)


def or_mask_for_bit(bit):
    """OrMask/AndMask a real ASS_OR_ATTRIBUTES call setting `bit` would
    produce (see altsnap.c's writeback-capture switch): or-mask has
    just that bit set, and-mask is all-1s."""
    ormask = [0] * ATTRSIZE
    ormask[bit // 8] |= (1 << (bit % 8))
    andmask = [0xff] * ATTRSIZE
    return hexmask(ormask), hexmask(andmask)


def and_mask_clearing_bit(bit):
    """OrMask/AndMask a real ASS_AND_ATTRIBUTES call clearing `bit`
    would produce: or-mask is all-0s, and-mask has every bit set
    except the cleared one (CUI_UndeleteMessage/CUI_MarkAsRead build
    their and-buffer with bone() + AMS_UNSET_ATTRIBUTE, i.e. all-1s
    with one bit cleared)."""
    ormask = [0] * ATTRSIZE
    andmask = [0xff] * ATTRSIZE
    andmask[bit // 8] &= ~(1 << (bit % 8)) & 0xff
    return hexmask(ormask), hexmask(andmask)


# ---- cui pty session (pattern from imap-sync-tests' CuiSession) ----

class CuiSession:
    def __init__(self, profiles_path, timeout=20.0):
        import pty
        self.timeout = timeout
        master, slave = pty.openpty()
        self.master = master
        env = dict(os.environ)
        env["PROFILES"] = profiles_path
        self.proc = subprocess.Popen([CUI], stdin=slave, stdout=slave, stderr=slave,
                                      close_fds=True, env=env)
        os.close(slave)
        self.buf = b""

    def _fill(self, idle=0.3):
        import select
        r, _, _ = select.select([self.master], [], [], idle)
        if self.master in r:
            try:
                chunk = os.read(self.master, 4096)
            except OSError:
                return False
            if not chunk:
                return False
            self.buf += chunk
        return True

    def send(self, text):
        os.write(self.master, text.encode())

    def collect(self, t=2):
        deadline = time.time() + t
        while time.time() < deadline:
            self._fill(idle=0.3)
        out = self.buf
        self.buf = b""
        return out

    def expect(self, patterns, timeout=None):
        """Reads until the earliest of `patterns` (bytes) appears; consumes
        output through the end of that match. Returns (pattern, text) on a
        match, or (None, text) on timeout/EOF. Used so a scripted answer is
        only ever sent once the prompt it answers has actually appeared."""
        timeout = self.timeout if timeout is None else timeout
        deadline = time.time() + timeout
        while True:
            best = None
            for p in patterns:
                i = self.buf.find(p)
                if i >= 0 and (best is None or i < best[0]):
                    best = (i, p)
            if best is not None:
                end = best[0] + len(best[1])
                text, self.buf = self.buf[:end], self.buf[end:]
                return best[1], text.decode(errors="replace")
            if time.time() >= deadline or not self._fill():
                text, self.buf = self.buf, b""
                return None, text.decode(errors="replace")

    def close(self):
        if self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=3)
            except Exception:
                self.proc.kill()


# cui's yes/no prompts during composition (GetBooleanFromUser in
# src/ams/msclients/cui/cuifns.c prints "<prompt> [No] ? "; the first two
# come from RealWhoIs()/cuilib.c:1766 and cui.c's SendSomeLines when an
# address cannot be verified, e.g. no white pages for an external
# domain). Answered "yes" only when actually seen. An unrecognized
# answer re-prints "Please answer yes or no." and then the prompt
# again, which this loop simply sees as the prompt again.
CUI_CONFIRM_PROMPTS = (
    b"really exists [No] ? ",
    b"Proceed with mail composition anyway [No] ? ",
    b"try sending anyway [No] ? ",
)
CUI_MAX_CONFIRMS = 6
CUI_SEND_PROMPT = b"(Type '?' for help) [type]: "   # MoreSelect's "CUI SEND>" prompt


def cui_compose_draft(sess, to, subject, body, folder, transcript):
    """Expect-style "mail" -> To/Subject/CC/body -> "draft" -> folder
    sequence, answering cui's address-verification confirmations only
    when they appear. Must be called at a "CUI> " prompt (already
    consumed). Appends everything seen to `transcript`. Returns
    (ok, reason); on any unexpected output it stops sending (the caller
    closes the session) rather than typing ahead into the wrong
    prompt."""
    def step(patterns, what, timeout=None):
        p, text = sess.expect(patterns, timeout)
        transcript.append(text)
        if p is None:
            raise RuntimeError(f"timed out waiting for {what}")
        return p

    def answer_confirmations(until, what):
        for _ in range(CUI_MAX_CONFIRMS + 1):
            p = step(CUI_CONFIRM_PROMPTS + (until,), what)
            if p == until:
                return
            sess.send("yes\n")
        raise RuntimeError(f"more than {CUI_MAX_CONFIRMS} confirmation prompts before {what}")

    try:
        sess.send("mail\n")
        step((b"To: ",), '"To: "')
        sess.send(f"{to}\n")
        answer_confirmations(b"Subject: ", '"Subject: "')
        sess.send(f"{subject}\n")
        step((b"CC: ",), '"CC: "')
        sess.send("\n")
        answer_confirmations(b"press control-d", "the message-body prompt")
        sess.send(f"{body}\n")
        sess.send("\x04")  # a real Ctrl-D -- EOF_STRING is "press control-d", not a typed sentinel
        step((CUI_SEND_PROMPT,), "the CUI SEND> prompt", timeout=30)
        sess.send("draft\n")
        step((b"save the draft message ? ",), "the draft-folder prompt")
        sess.send(f"{folder}\n")
        p = step((b"Draft saved in folder", b"Could not save draft", CUI_SEND_PROMPT),
                 "the draft-save result", timeout=30)
        if p != b"Draft saved in folder":
            return False, "cui did not save the draft (see transcript)"
        step((b"CUI> ",), "the CUI> prompt after saving the draft")
        return True, ""
    except (RuntimeError, OSError) as e:   # OSError: cui exited under us
        return False, str(e)


def run_cui_mutations(root):
    """Points cui's mspath at the scratch mirror (scratch PROFILES,
    never ~/preferences), lists FOLDER, then against message #2 (the
    on-disk order is stable right after a fresh mirror): delete (OR
    path, sets AMS_ATT_DELETED), undelete (AND path, clears it),
    delete again (OR path, sets it back for the purge below), then
    purges the folder. Also attempts "type 1" first, to exercise the
    read-marking call site -- message #1 was seeded with \\Seen already
    set (see append_seed_message()), so CUI_MarkAsRead's own guard
    correctly no-ops (proving the hook adds no spurious record when
    nothing actually changes, rather than a synthetic "it always fires"
    case). Returns the full transcript text."""
    assert_folder_is_sandbox(FOLDER)
    profiles = os.path.join(root, "PROFILES")
    with open(profiles, "w", newline="\n") as f:
        f.write(f"mspath: {os.path.join(root, '.MESSAGES')}\n")

    transcript = []
    sess = CuiSession(profiles)
    try:
        transcript.append(sess.collect(2).decode(errors="replace"))
        sess.send(f"headers {FOLDER}\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
        sess.send("type 1\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
        sess.send("delete 2\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
        sess.send("undelete 2\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
        sess.send("delete 2\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
        # cui's purge removes every \\Deleted message in FOLDER's local
        # mirror, and the journal it writes is replayed server-side by
        # the next imapsync run. Acceptable only because
        # preflight_folder() has just verified FOLDER holds nothing but
        # harness-created messages (and only cuid 2 is \\Deleted).
        sess.send(f"purge {FOLDER}\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
        sess.send("quit\n")
        transcript.append(sess.collect(2).decode(errors="replace"))
    finally:
        sess.close()
    return "\n".join(t for t in transcript if isinstance(t, str))


def run_cui_append(root, subject):
    """Case 5 (Gate 3): lands a genuinely native-id (non-deterministic)
    local message directly into FOLDER via cui's "mail" -> compose ->
    "draft" (SEND_SAVEDRAFT) path, which calls
    MS_AppendFileToFolder(TmpName, FolderName) -- no IMAP, no SMTP (a
    draft is never submitted) -- exactly the
    MS_AppendFileToFolder/apndfile.c mutation point the writeback
    design names for the "append" journal record ("e.g. a user
    copies/moves a message in from a local folder"). Reuses the same
    scratch PROFILES run_cui_mutations() already wrote (same mspath,
    never ~/preferences).

    Chosen over cui's own "copy" command after checking both routes
    hit MS_CloneMessage's own guard: copying a message that is already
    inside FOLDER back into FOLDER hits the same-source/dest-folder
    check (EMSALREADYTHERE, clonemsg.c); copying it out to a second
    folder and back in preserves the exact same id (a bcopy of the
    snapshot bytes, not a fresh invention), so the return trip hits the
    identical guard for the opposite reason (that id already exists at
    the destination). Composing fresh is the only real, cui-driven way
    to get a genuinely new native id into FOLDER. cui's address
    verification may ask "Are you sure the host '...' really exists" and
    "Proceed with mail composition anyway" for AUIS_TEST_ADDRESS;
    cui_compose_draft() answers "yes" to those only when they appear.
    Returns (ok, reason, transcript text)."""
    assert_folder_is_sandbox(FOLDER)
    profiles = os.path.join(root, "PROFILES")

    transcript = []
    sess = CuiSession(profiles)
    try:
        p, text = sess.expect((b"CUI> ",), timeout=30)
        transcript.append(text)
        if p is None:
            return False, "cui did not print its CUI> prompt", "".join(transcript)
        ok, why = cui_compose_draft(
            sess, TEST_ADDRESS, subject,
            f"imap-writeback-tests case 5 append-round-trip probe body ({subject}).",
            FOLDER, transcript)
        if ok:
            sess.send("quit\n")
            transcript.append(sess.collect(2).decode(errors="replace"))
    finally:
        sess.close()
    return ok, why, "".join(transcript)


def run_cui_acceptance(root):
    """The milestone's own end-to-end acceptance test (distinct from
    the numbered test cases above): mark-read, delete+purge, and
    copy-in (compose+save-as-draft) -- Milestone 4's three local
    mutation kinds -- all in ONE scripted cui session against a fresh
    two-message mirror (message 1: mark-read target; message 2:
    delete+purge target), so a single subsequent imapsync run
    (replay+mirror in one invocation) has all three journal record
    kinds to replay together. Returns (ok, reason, transcript text) --
    ok covers only the scripted compose/draft-save step."""
    assert_folder_is_sandbox(FOLDER)
    profiles = os.path.join(root, "PROFILES")
    with open(profiles, "w", newline="\n") as f:
        f.write(f"mspath: {os.path.join(root, '.MESSAGES')}\n")

    transcript = []
    sess = CuiSession(profiles)
    try:
        transcript.append(sess.collect(2).decode(errors="replace"))
