def table_run(opens, closes, cell):
    """opens <table>s, closed closes times (a mismatch either way)."""
    out = []
    for i in range(opens):
        out.append('<table border="0" width="100%%"><tr><td>%s %d' % (cell, i + 1))
    for i in range(closes):
        out.append('</td></tr></table>')
    return "\n".join(out) + "\n"


