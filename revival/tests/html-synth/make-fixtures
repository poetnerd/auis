def cid_grid(names, cols, alt_prefix):
    cells, rows = [], []
    for i, n in enumerate(names):
        cells.append('<td><img src="cid:%s" width="64" height="64" alt="%s %d">'
                     '</td>' % (n, alt_prefix, i + 1))
        if len(cells) == cols:
            rows.append("<tr>" + "".join(cells) + "</tr>")
            cells = []
    if cells:
        rows.append("<tr>" + "".join(cells) + "</tr>")
    return ('<table border="0" cellpadding="2">'
            '<tr><td colspan="%d" style="font-weight:bold">%s</td></tr>%s'
            '</table>\n' % (cols, alt_prefix, "".join(rows)))


