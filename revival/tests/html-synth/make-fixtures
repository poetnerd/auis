def nested_tables(depth, inner, img_every=0):
    """depth well-formed nested border=0 layout tables around inner."""
    out = inner
    for level in range(depth, 0, -1):
        img = ""
        if img_every and level % img_every == 0:
            img = ('<img src="https://images.example.com/spacer-%d.gif" '
                   'width="20" height="4" alt="">' % level)
        out = ('<table border="0" cellpadding="0" cellspacing="0" width="100%%">'
               '<tr><td style="padding:2px">%s%s</td></tr></table>\n'
               % (img, out))
    return out


