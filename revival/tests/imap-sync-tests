def missing_vars_message():
    """Returns (missing_names, message) -- message is None when nothing
    is missing. Printed once, at the start of main()."""
    missing = [(n, ex) for n, ex in REQUIRED_VARS if not _env(n)]
    if not missing:
        return [], None
    lines = ["Live-account cases skipped; set these to run them:"]
    lines += [f"    export {n}={ex}" for n, ex in missing]
    lines.append("(credentials come from ~/.netrc, machine = the host)")
    names = [n for n, _ in missing]
    if "AUIS_TEST_FOLDER" in names:
        lines.append("AUIS_TEST_FOLDER must be a dedicated scratch folder holding no real mail; "
                     "live runs refuse a folder containing any message a harness did not create.")
        lines.append(f"Note: imaptest.c:400 only permits writes to {IMAPTEST_ONLY_WRITE_FOLDER!r}, "
                     "so that is currently the only folder the W-cases can use.")
