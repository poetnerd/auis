def append_test_message(folder, subject, tmpdir, tag):
    """APPENDs a small message with the given subject into folder via
    imap_Append (imaptest.test's append subcommand), returning
    (uidvalidity, uid) from the APPENDUID response code, or (None,
    None) on failure. Records the APPENDUID in RECORDED_APPENDS
    for cleanup. `subject` must start with a HARNESS_SUBJECT_MARKERS
    entry."""
    if not is_harness_subject(subject):
        sys.exit(f"imap-sync-tests: internal error -- subject {subject!r} carries no harness marker")
    bodyfile = os.path.join(tmpdir, f"append-{tag}.eml")
    with open(bodyfile, "wb") as f:
        f.write(
            f"Date: {time.strftime('%a, %d %b %Y %H:%M:%S %z')}\r\n"
            f"From: {TEST_ADDRESS}\r\n"
            f"To: {TEST_ADDRESS}\r\n"
            f"Subject: {subject}\r\n"
            f"\r\n"
            f"imap-sync-tests writeback-case probe message ({tag}).\r\n"
        .encode())
    r, kv = imaptest_wb("append", folder, bodyfile)
    if r.returncode != 0 or kv.get("APPEND-RC") != "0":
        return None, None
    uv = kv.get("APPEND-UIDVALIDITY")
    uid = kv.get("APPEND-UID")
    if uv is None or uid is None or not uv.isdigit() or not uid.isdigit():
        return None, None
    RECORDED_APPENDS.append((int(uv), int(uid)))
    return int(uv), int(uid)


def crlf_normalize(raw_bytes):
    """Python mirror of imap_sync.c's crlf_stage_body(): local MS_
    storage is plain LF-terminated text, but a real APPEND literal
    containing a bare LF is rejected server-side ("Message contains
    bare newlines", confirmed live against Fastmail during Gate 3) --
    used here only to prepare a manually-driven imaptest_wb("append",
    ...) call in W6 that stands in for "the crashed run's own APPEND,
    which already succeeded" (imap_Append itself has no such
    normalization built in -- imap_sync.c's replay path is the one
    responsible for it, mirrored here so this test's manual pre-apply
    step hits the same real protocol requirement rather than assuming
    it away)."""
    text = raw_bytes.decode("latin-1")
    lines = text.splitlines(keepends=False)
    return ("\r\n".join(lines) + ("\r\n" if text.endswith(("\n", "\r")) else "")).encode("latin-1")


def create_local_draft_via_cui(root, folder, subject, body):
    """W5/W6 (Gate 3): lands a genuinely native-id (non-deterministic)
    local message directly into folder via cui's "mail" -> compose ->
    "draft" (SEND_SAVEDRAFT) path -- MS_AppendFileToFolder, no IMAP, no
    SMTP (a draft is never submitted). Same mechanism, and the same
    reasoning for why it's used instead of a literal cui "copy", as
    imap-writeback-tests' run_cui_append() (see that function's
    docstring in the sibling suite): there is no way to fabricate a
    genuinely new native-id local message from Python alone without
    hand-writing .MS_MsgDir binary bytes, which this suite avoids on
    principle (see the module docstring's "fabricate journal lines
    directly... rather than driving a real cui session" -- that
    principle applies to REPLAY testing; there is no substitute for a
    real store call to CREATE the one native-id fixture message replay
    then acts on). cui's address verification may ask "Are you sure the
    host '...' really exists" and "Proceed with mail composition anyway"
    for AUIS_TEST_ADDRESS; cui_compose_draft() answers "yes" to those
    only when they appear. Returns (ok, reason, transcript text)."""
    assert_write_mailbox(folder)
    profiles_path = os.path.join(root, "PROFILES")
    with open(profiles_path, "w", newline="\n") as f:
        f.write(f"mspath: {os.path.join(root, '.MESSAGES')}\n")

    transcript = []
    ok, why = False, "cui session did not start"
    sess = CuiSession(profiles_path)
    try:
        p, text = sess.expect((b"CUI> ",), timeout=30)
        transcript.append(text)
        if p is None:
            return False, "cui did not print its CUI> prompt", "".join(transcript)
        ok, why = cui_compose_draft(sess, TEST_ADDRESS, subject, body, folder, transcript)
        if ok:
            sess.send("quit\n")
            transcript.append(sess.collect(2).decode(errors="replace"))
    finally:
        sess.close()
    return ok, why, "".join(transcript)


