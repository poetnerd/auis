_BASE32HEX = "0123456789ABCDEFGHIJKLMNOPQRSTUV"


def encode_base32hex7(v):
    """Python mirror of imap_sync.c's encode_base32hex7() -- used only
    to fabricate a deliberately-WRONG-UIDVALIDITY id for case W7; every
    other case reads real ids back from the mirror's own body-file
    names rather than re-deriving them, so this isn't load-bearing for
    the id format itself."""
    return "".join(_BASE32HEX[(v >> ((6 - i) * 5)) & 0x1F] for i in range(7))


def synth_id_py(uidvalidity, uid):
    return "IMAP" + encode_base32hex7(uidvalidity) + encode_base32hex7(uid)


# ---- folder safety for the W-cases: listing, preflight, UID-exact
# cleanup (same logic as imap-writeback-tests') ----

_SYNTH_ID_RE = re.compile(r"^IMAP([0-9A-V]{7})([0-9A-V]{7})$")


def decode_synth_id(ident):
    """Inverse of imap_sync.c's synth_id(): "IMAP" + base32hex7(uidvalidity)
    + base32hex7(uid). Returns (uidvalidity, uid), or None if ident is not
    a deterministic imapsync id."""
    m = _SYNTH_ID_RE.match(ident)
    if not m:
        return None

    def dec(chars):
        v = 0
        for c in chars:
            v = (v << 5) | _BASE32HEX.index(c)
        return v
    return dec(m.group(1)), dec(m.group(2))


def read_subject(path):
    """Decoded Subject header of a mirrored body file, or "" if absent or
    unparseable (which counts as a non-harness message -- the safe way to
    be wrong)."""
    import email.parser
    import email.policy
    try:
        with open(path, "rb") as f:
            msg = email.parser.BytesParser(policy=email.policy.default).parse(f, headersonly=True)
        subj = msg.get("Subject")
        return str(subj) if subj is not None else ""
    except Exception:
        return ""


def examine_folder():
    """(exists, uidvalidity, uidnext) for WRITE_MAILBOX via a read-only EXAMINE,
    or None if EXAMINE failed (e.g. the folder does not exist yet)."""
    _, kv = imaptest_readonly("examine", WRITE_MAILBOX)
    if kv.get("EXAMINE-RC") != "0":
        return None
    try:
        return int(kv["EXISTS"]), int(kv["UIDVALIDITY"]), int(kv.get("UIDNEXT", "0") or 0)
    except (KeyError, ValueError):
        return None


def list_folder_messages():
    """Every message in WRITE_MAILBOX as [(uidvalidity, uid, subject), ...], via
    an imapsync mirror into a brand-new throwaway root. A fresh root has
    no .MS_Journal, so replay_folder() has nothing to act on and imapsync
    only EXAMINEs/FETCHes (read-only). Returns (list, None) or
    (None, reason)."""
    root = tempfile.mkdtemp(prefix="imap-sync-tests-listing-")
    try:
        r = subprocess.run([IMAPSYNC, "-root", root, "-folders", WRITE_MAILBOX],
                            capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            return None, f"read-only imapsync listing failed (exit {r.returncode}): {r.stderr.strip()[-300:]}"
        d = folder_dir_for(root, WRITE_MAILBOX)
        msgs = []
        if os.path.isdir(d):
            for name in sorted(os.listdir(d)):
                if not name.startswith("+"):
                    continue
                dec = decode_synth_id(name[1:])
                if dec is None:
                    return None, f"unexpected non-imapsync id {name!r} in listing mirror"
                msgs.append((dec[0], dec[1], read_subject(os.path.join(d, name))))
        return msgs, None
    finally:
        shutil.rmtree(root, ignore_errors=True)


def expunge_uids(uids, uidvalidity):
    """Deletes exactly these UIDs (UID STORE +FLAGS \\Deleted then UID
    EXPUNGE of the same explicit set -- imaptest.c cmd_expunge; UID
    EXPUNGE needs UIDPLUS and imap_prot.c refuses rather than falling
    back to a plain EXPUNGE). Re-checks UIDVALIDITY first so a UID can
    never name a different message. Returns (ok, detail)."""
    uids = sorted({int(u) for u in uids})
    if not uids:
        return True, "nothing to remove"
    if any(u <= 0 for u in uids):
        return False, f"refusing non-positive UID in {uids}"
    now = examine_folder()
    if now is None or now[1] != uidvalidity:
        return False, (f"UIDVALIDITY changed or EXAMINE failed (expected {uidvalidity}, got "
                       f"{None if now is None else now[1]}) -- not removing UIDs {uids}")
    uidset = ",".join(str(u) for u in uids)
    r, kv = imaptest_wb("expunge", WRITE_MAILBOX, uidset)
    ok = (r.returncode == 0 and kv.get("EXPUNGE-RC") == "0"
          and kv.get("POSTEXPUNGE-STILL-PRESENT") == "no")
    return ok, f"UID set {uidset}: exit={r.returncode} kv={kv}"


def preflight_folder(label):
    """Before any write: verify WRITE_MAILBOX holds nothing but harness-created
    messages (Subject starts with one of HARNESS_SUBJECT_MARKERS). Creates
    the folder if it does not exist. Any other message => refuse, touching
    nothing. Leftover harness messages from earlier runs are removed by
    exact UID so the run starts from an empty folder. Sets PREFLIGHT_OK.
    Returns (ok, reason)."""
    global PREFLIGHT_OK
    PREFLIGHT_OK = False
    info = examine_folder()
    if info is None:
        cr, ckv = imaptest_wb("create", WRITE_MAILBOX)
        note(f"preflight ({label}): {WRITE_MAILBOX!r} not examinable; CREATE -> exit={cr.returncode} kv={ckv}")
        info = examine_folder()
        if info is None:
            return False, f"could not EXAMINE (or create) {WRITE_MAILBOX!r}"
    exists, uidvalidity, _ = info
    if exists == 0:
        PREFLIGHT_OK = True
        note(f"preflight ({label}): {WRITE_MAILBOX!r} is empty -- OK")
        return True, ""
    msgs, err = list_folder_messages()
    if msgs is None:
        return False, f"could not list {WRITE_MAILBOX!r} to verify its contents ({err}); refusing to touch it"
    if len(msgs) != exists:
        return False, (f"listing of {WRITE_MAILBOX!r} saw {len(msgs)} message(s) but EXAMINE reports "
                       f"{exists}; cannot verify its contents, refusing to touch it")
    if any(uv != uidvalidity for uv, _, _ in msgs):
        return False, f"UIDVALIDITY of {WRITE_MAILBOX!r} changed during preflight; refusing to touch it"
    foreign = [uid for _, uid, subj in msgs if not is_harness_subject(subj)]
    if foreign:
        return False, (f"{WRITE_MAILBOX!r} contains {len(foreign)} message(s) not created by a test "
                       f"harness (UIDs {foreign}). AUIS_TEST_FOLDER must be a dedicated scratch "
                       "folder holding no real mail -- refusing the live run; nothing was changed")
    leftovers = [uid for _, uid, _ in msgs]
    PREFLIGHT_OK = True   # verified: everything present is harness-created
    ok, detail = expunge_uids(leftovers, uidvalidity)
    note(f"preflight ({label}): removed {len(leftovers)} leftover harness message(s) "
         f"from earlier runs -> {'ok' if ok else 'FAILED'}: {detail}")
    info = examine_folder()
    if not ok or info is None or info[0] != 0:
        PREFLIGHT_OK = False
        return False, (f"{WRITE_MAILBOX!r} not empty after removing harness leftovers "
                       f"(EXISTS={None if info is None else info[0]}); refusing to continue")
    return True, ""


def cleanup_folder(label):
    """Removes only harness-created messages: every message whose Subject
    carries a harness marker (this covers this run's APPENDs and the
    drafts imapsync's replay APPENDed for it), found via a fresh
    read-only listing. If listing fails, falls back to just the
    (uidvalidity, uid) pairs this run's own APPENDs reported. Never
    touches any other message, never uses a range."""
    if not PREFLIGHT_OK:
        note(f"cleanup ({label}): skipped -- preflight did not pass, {WRITE_MAILBOX!r} left untouched")
        return
    info = examine_folder()
    if info is None:
        note(f"cleanup ({label}): WARNING -- could not EXAMINE {WRITE_MAILBOX!r}; left in place: "
             f"this run's appended (uidvalidity, uid) = {RECORDED_APPENDS}")
        return
    exists, uidvalidity, _ = info
    if exists == 0:
        note(f"cleanup ({label}): {WRITE_MAILBOX!r} already empty, nothing to remove")
        return
    msgs, err = list_folder_messages()
    if msgs is None:
        uids = [uid for uv, uid in RECORDED_APPENDS if uv == uidvalidity]
        note(f"cleanup ({label}): listing failed ({err}); falling back to this run's own "
             f"recorded APPEND UIDs only: {uids} (other harness messages, e.g. replayed drafts, "
             "are left for the next run's preflight)")
    else:
        present = {uid: subj for uv, uid, subj in msgs if uv == uidvalidity}
        uids = [uid for uid, subj in present.items() if is_harness_subject(subj)]
        others = [uid for uid, subj in present.items() if not is_harness_subject(subj)]
        if others:
            note(f"cleanup ({label}): WARNING -- {len(others)} non-harness message(s) appeared in "
                 f"{WRITE_MAILBOX!r} during the run (UIDs {others}); left untouched")
        odd = [uid for uv, uid in RECORDED_APPENDS
               if uv == uidvalidity and uid in present and uid not in uids]
        if odd:
            note(f"cleanup ({label}): WARNING -- recorded APPEND UIDs {odd} no longer carry a "
                 "harness marker subject; left untouched")
    if not uids:
        note(f"cleanup ({label}): no harness-created messages to remove")
        return
    ok, detail = expunge_uids(uids, uidvalidity)
    if ok:
        note(f"cleanup ({label}): removed {len(uids)} harness-created message(s): {detail}")
    else:
        note(f"cleanup ({label}): WARNING -- removal failed, UIDs {sorted(uids)} left in "
             f"{WRITE_MAILBOX!r}: {detail}")


ATTRSIZE = 21


def hexmask(bytelist):
    return "".join("%02x" % b for b in bytelist)


def or_mask_for_bit(bit):
    """The OrMask/AndMask a real ASS_OR_ATTRIBUTES call setting `bit`
    would produce (see altsnap.c's writeback-capture switch, and
    imap-writeback-tests' identical helper): or-mask has just that bit
    set, and-mask is all-1s -- forces the bit ON regardless of the
    server's prior value."""
    ormask = [0] * ATTRSIZE
    ormask[bit // 8] |= (1 << (bit % 8))
    andmask = [0xff] * ATTRSIZE
    return hexmask(ormask), hexmask(andmask)


def and_mask_clearing_bit(bit):
    """The OrMask/AndMask a real ASS_AND_ATTRIBUTES call clearing `bit`
    would produce: or-mask all-0s, and-mask all-1s except the cleared
    bit -- forces the bit OFF regardless of the server's prior value."""
    ormask = [0] * ATTRSIZE
    andmask = [0xff] * ATTRSIZE
    andmask[bit // 8] &= ~(1 << (bit % 8)) & 0xff
    return hexmask(ormask), hexmask(andmask)


def write_journal_lines(root, folder, lines):
    path = journalpath_for(root, folder)
    with open(path, "w", newline="\n") as f:
