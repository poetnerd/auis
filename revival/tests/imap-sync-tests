def build(dirpath, target, binpath, timeout=180):
    """make Makefile (bootstrapping via imake if it's not there yet --
    the tree's own dependency check regenerates it if the Imakefile
    changed), then build target. Mirrors imap-protocol-tests'
    build_driver()."""
    if not os.path.isfile(os.path.join(dirpath, "Makefile")):
        r = subprocess.run(["imake", "-Timake.tmpl", "-I.", "-I../../../config",
                             "-s", "Makefile", "-DTOPDIR=../../../."],
                            cwd=dirpath, capture_output=True, text=True)
        if r.returncode != 0:
            note(r.stdout); note(r.stderr)
            sys.exit(f"imap-sync-tests: could not bootstrap Makefile in {dirpath}")
    r = subprocess.run(["make", "Makefile"], cwd=dirpath, capture_output=True, text=True)
    if r.returncode != 0:
        note(r.stdout); note(r.stderr)
        sys.exit(f"imap-sync-tests: 'make Makefile' failed in {dirpath}")
    r = subprocess.run(["make", target], cwd=dirpath, capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0 or not os.path.isfile(binpath):
        note(r.stdout); note(r.stderr)
        sys.exit(f"imap-sync-tests: 'make {target}' failed in {dirpath}")


