+               between adjacent encoded-words, so the space before this
+               word goes inside it, as '_'. */
+            long wl = 0;
+            strcpy(word, EW_PREFIX); wl = (long) strlen(word);
+            if (prevenc) word[wl++] = '_';
+            for (k = ws; k < we; ++k) {
+                unsigned char c = (unsigned char) in[k];
+                if (wl + 3 + 2 > EW_MAX) {	/* room for "=XX" and "?=" */
