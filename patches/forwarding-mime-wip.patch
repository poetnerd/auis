+/* Whether the text just emitted (b's tail, trailing spaces aside)
+   already is s. */
+static int buffer_ends_with(const struct htbuf *b, const char *s)
+{
+    long n = (long) strlen(s), e = b->len;
+
+    while (e > 0 && b->data[e - 1] == ' ') --e;
