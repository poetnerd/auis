+   a reply's decoded subject (reply.c), is Latin-1, so its 8-bit words
+   go out as RFC 2047 encoded-words.  Other headers are left as they
+   are: encoding inside address phrases must respect address syntax. */
+static int EncodeSubject(struct MS_Message *Msg)
+{
+    char *subj, *enc, *head;
+    long len = Msg->ParsedStuff->HeadBodyLen[HP_SUBJECT], i;
+    int high = 0;
