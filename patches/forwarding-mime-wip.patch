+
+/* Encodes one Latin-1 value for a "Subject: " header, then decodes it
+   back, printing both. */
+static int do_encode(const char *value)
+{
+    char *e = mimepart_EncodeHeader(value, (long) strlen(value), 9);
+    char *d = e ? mimepart_DecodeHeader(e, (long) strlen(e)) : NULL;
+    printf("Subject: %s\n<- [%s]\n", e ? e : "(null)", d ? d : "(null)");
+    free(e); free(d);
+    return 0;
