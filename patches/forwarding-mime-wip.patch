+}
 
 static void emit_href_suffix(struct htbuf *b, const struct htmlnode *n)
 {
     const char *href = htmlpart_GetAttr(n, "href");
 
     if (!href || !href[0]) return;
+    /* A link whose text is its own address needs no "(address)":
+       "https://x (https://x)" read as markup, not a link
+       (2026-11-15).  Likewise a mailto: shown as the bare address. */
+    if (buffer_ends_with(b, href)) return;
+    if (strncasecmp(href, "mailto:", 7) == 0 && buffer_ends_with(b, href + 7)) return;
     maybe_space(b);
     htbuf_putc(b, '(');
     htbuf_puts(b, href);
     htbuf_putc(b, ')');
 }

