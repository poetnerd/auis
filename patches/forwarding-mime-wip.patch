+            char *w = (char *) malloc(n + 1);
+            if (!w) break;
+            memcpy(w, in + ws, n); w[n] = '\0';
+            enc_append(out, &o, &linelen, w, first ? "" : " ");
+            free(w);
+            prevenc = 0;
+        } else {
